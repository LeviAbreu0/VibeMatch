{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/track/:id", "destination": "/index.html" },
    { "source": "/track/:id/", "destination": "/index.html" }
  ]
}
